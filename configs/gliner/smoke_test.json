{
  "base_model": "knowledgator/gliner-pii-base-v1.0",
  "train_data": "../outputs/smoke_test/data/train_gliner.json",
  "val_data": "../outputs/smoke_test/data/val_gliner.json",
  "output_dir": "../outputs/smoke_test_run2",
  "learning_rate": 1e-05,
  "batch_size": 4,
  "eval_batch_size": 8,
  "epochs": 1,
  "warmup_ratio": 0.1,
  "weight_decay": 0.01,
  "seed": 42,
  "eval_steps": 5,
  "logging_steps": 1,
  "threshold": 0.4,
  "flat_ner": false,
  "gradient_accumulation_steps": 1,
  "max_grad_norm": 1.0,
  "adam_beta1": 0.9,
  "adam_beta2": 0.999,
  "adam_epsilon": 1e-08,
  "lr_scheduler_type": "linear",
  "loss_reduction": "mean",
  "device": "auto"
}
